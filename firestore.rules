rules_version = '2';

// Pravila pristupa Firestore bazi projekta „Aj uzmi mi".
//
// PAŽNJA — ovo su PRIVREMENA pravila za period dok se aplikacija razvija.
// Do datuma ispod svako ko zna adresu baze može da čita i piše. To je u redu
// samo zato što u bazi za sad stoje izmišljene, probne porudžbine i nijedan
// podatak prave mušterije.
//
// Čim se doda prijava (Firebase Authentication), ova pravila se menjaju u:
//
//   allow read, write: if request.auth != null;
//
// čime pristup dobija samo prijavljen kurir. Posle tog datuma baza se sama
// zaključava — ako aplikacija odjednom javi „Nema veze sa bazom", prvo
// proveriti da li je istekao ovaj rok.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 10, 10);
    }
  }
}
