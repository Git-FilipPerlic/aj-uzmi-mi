rules_version = '2';

// Pravila pristupa Firestore bazi projekta „Aj uzmi mi".
//
// Čitati i pisati sme samo prijavljen korisnik (Firebase Authentication).
//
// „Prijavljen" ovde znači „kurir" SAMO ZATO što je u Firebase konzoli
// isključeno samostalno pravljenje naloga (Authentication → Settings → User
// actions → „Enable create"). Nalozi se prave ručno u konzoli. Ako se to ikad
// ponovo uključi, bilo ko sa javnim ključem aplikacije može sebi da napravi
// nalog i čita porudžbine — pa to ne uključivati bez promene ovih pravila.
//
// Kad backend agent počne da upisuje porudžbine, on ide preko Admin SDK-a,
// koji ova pravila zaobilazi, pa ga ne treba posebno puštati.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
